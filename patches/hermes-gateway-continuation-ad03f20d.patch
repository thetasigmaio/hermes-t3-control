new file mode 100644
index 000000000..c3789eba6
--- /dev/null
+++ b/hermes_cli/plugin_notifications.py
@@ -0,0 +1,66 @@
+"""Explicit plugin notices to the configured Telegram home, without a model turn."""
+from __future__ import annotations
+
+
+def _configured(ctx):
+    from gateway.config import Platform, load_gateway_config
+    if getattr(ctx, 'profile_name', None) != 'default' or not ctx._gateway_injection_allowed():
+        return None
+    config = load_gateway_config()
+    platform = config.platforms.get(Platform.TELEGRAM)
+    home = config.get_home_channel(Platform.TELEGRAM)
+    if platform is None or not platform.enabled or not platform.token or home is None:
+        return None
+    target = {'profile_name': 'default', 'platform': 'telegram',
+              'chat_id': str(home.chat_id), 'topic_id': str(home.thread_id or '')}
+    if not target['chat_id'].lstrip('-').isdigit() or (target['topic_id'] and not target['topic_id'].isdigit()):
+        return None
+    return target, platform.token
+
+
+def resolve_target(ctx):
+    configured = _configured(ctx)
+    return dict(configured[0]) if configured else None
+
+
+async def send_notice(ctx, content, *, destination, eligibility_check):
+    from telegram import Bot
+    from telegram.error import BadRequest, Forbidden, RetryAfter
+    from telegram.request import HTTPXRequest
+    from gateway.platforms.base import resolve_proxy_url
+
+    configured = _configured(ctx)
+    if configured is None or destination != configured[0]:
+        return {'status': 'route_mismatch'}
+    if not isinstance(content, str) or not content.strip() or len(content) > 1024:
+        return {'status': 'invalid_content'}
+    # A proxy is a transport setting, not a reason to fall back to a different route.
+    proxy = resolve_proxy_url('TELEGRAM_PROXY', target_hosts=['api.telegram.org'])
+    request = HTTPXRequest(proxy=proxy, connect_timeout=10, read_timeout=20, write_timeout=20)
+    try:
+        async with Bot(token=configured[1], request=request) as bot:
+            if not callable(eligibility_check) or eligibility_check() is not True:
+                return {'status': 'cancelled'}
+            if resolve_target(ctx) != destination:
+                return {'status': 'route_mismatch'}
+            topic = destination['topic_id']
+            kwargs = {'message_thread_id': int(topic)} if topic and topic != '1' else {}
+            # No topic fallback, parsing fallback, automatic retry or transcript mirroring.
+            message = await bot.send_message(chat_id=destination['chat_id'], text=content, **kwargs)
+            actual_topic = str(getattr(message, 'message_thread_id', None) or '')
+            if topic == '1' and not actual_topic:
+                actual_topic = '1'
+            if str(message.chat.id) != destination['chat_id'] or actual_topic != topic:
+                return {'status': 'uncertain', 'reason': 'returned_route_mismatch'}
+            if type(message.message_id) is not int or message.message_id <= 0:
+                return {'status': 'uncertain', 'reason': 'missing_message_id'}
+            return {'status': 'delivered', 'message_id': str(message.message_id), 'destination': dict(destination)}
+    except RetryAfter as exc:
+        delay = exc.retry_after
+        seconds = delay.total_seconds() if hasattr(delay, 'total_seconds') else float(delay)
+        return {'status': 'retryable', 'retry_after': min(300, max(1, seconds))}
+    except (BadRequest, Forbidden):
+        return {'status': 'rejected'}
+    except Exception:
+        # Network/timeout may follow a successful remote write: do not retry blindly.
+        return {'status': 'uncertain'}
