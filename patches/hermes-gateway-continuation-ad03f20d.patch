+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import pytest
+from hermes_cli import plugin_notifications as notices
+from gateway.config import Platform
+
+TARGET = dict(profile_name='default',platform='telegram',chat_id='123',topic_id='456')
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('outcome', ['delivered','wrong_route','missing_topic','timeout','rate_limit','cancel'])
+async def test_exact_topic_notice_is_single_send_and_never_falls_back(monkeypatch, outcome):
+    import telegram
+    from telegram.error import BadRequest, TimedOut, RetryAfter
+    ctx=SimpleNamespace(profile_name='default',_gateway_injection_allowed=lambda:True)
+    monkeypatch.setattr(notices,'_configured',lambda ctx:(TARGET,'not-a-real-token'))
+    bot=SimpleNamespace(send_message=AsyncMock(return_value=SimpleNamespace(chat=SimpleNamespace(id=123),message_thread_id=456,message_id=42)))
+    if outcome=='wrong_route':bot.send_message.return_value.message_thread_id=999
+    errors={'missing_topic':BadRequest('Message thread not found'),'timeout':TimedOut(),'rate_limit':RetryAfter(2)}
+    if outcome in errors:bot.send_message.side_effect=errors[outcome]
+    class Bot:
+        def __init__(self, **kwargs):pass
+        async def __aenter__(self):return bot
+        async def __aexit__(self,*args):pass
+    monkeypatch.setattr(telegram,'Bot',Bot)
+    monkeypatch.setattr('gateway.platforms.base.resolve_proxy_url',lambda *args,**kwargs:None)
+    result=await notices.send_notice(ctx,'Verified',destination=TARGET,eligibility_check=lambda:outcome!='cancel')
+    assert result['status']=={'delivered':'delivered','wrong_route':'uncertain','missing_topic':'rejected','timeout':'uncertain','rate_limit':'retryable','cancel':'cancelled'}[outcome]
